<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="300.0" prefWidth="350.0" style="-fx-background-color: #E0E0D6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.poli.mvc.controlador.ControladorModificar">
   <children>
      <Label layoutX="14.0" layoutY="20.0" text="Código del Traje:" />
      <TextField fx:id="modificarCodigo" layoutX="130.0" layoutY="16.0" promptText="Ej: T-001" />

      <Button fx:id="btnBuscar" layoutX="100.0" layoutY="50.0" onAction="#buscarTraje" style="-fx-background-color: #2DA9D2; -fx-text-fill: white;" text="Buscar para Editar" />

      <VBox fx:id="panelCampos" layoutX="14.0" layoutY="90.0" spacing="10.0" visible="false">
         <children>
            <Label text="Material:" />
            <TextField fx:id="modificarMaterial" />
            <Label text="Peso:" />
            <TextField fx:id="modificarPeso" />
            <Label text="Altura:" />
            <TextField fx:id="modificarAltura" />
            <Button onAction="#modificar" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Guardar Cambios" />
         </children>
      </VBox>
   </children>
</AnchorPane>