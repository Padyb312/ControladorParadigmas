<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.poli.actividad9.SecondaryController">
    <children>

        <Pane fx:id="miPane" prefHeight="100.0" prefWidth="200.0"
              style="-fx-background-color: #DB0FD1; -fx-background-radius: 8;">
            <children>
                <Button fx:id="botonInterno" layoutX="29.0" layoutY="35.0"
                        mnemonicParsing="false" text="Boton Interno"
                        onAction="#accionBotonInterno">
                    <textFill>
                        <LinearGradient endX="1.0" endY="1.0"
                                        startX="0.7585227272727273"
                                        startY="0.2717803030303032">
                            <stops>
                                <Stop>
                                    <color>
                                        <Color red="0.148" green="0.768" blue="0.572" />
                                    </color>
                                </Stop>
                                <Stop offset="1.0">
                                    <color>
                                        <Color red="1.0" green="1.0" blue="1.0" />
                                    </color>
                                </Stop>
                            </stops>
                        </LinearGradient>
                    </textFill>
                </Button>
                <Label fx:id="labelHola" layoutX="105.0" layoutY="39.0" text="Hola Mundo"
                       style="-fx-text-fill: white; -fx-font-weight: bold;" />
            </children>
        </Pane>

        <Label text="Cambiar color del panel:" style="-fx-font-weight: bold;" />
        <HBox alignment="CENTER" spacing="10.0">
            <Button text="Morado"   onAction="#colorMorado"
                    style="-fx-background-color: #8e44ad; -fx-text-fill: white;" />
            <Button text="Naranja"  onAction="#colorNaranja"
                    style="-fx-background-color: #e67e22; -fx-text-fill: white;" />
            <Button text="Turquesa" onAction="#colorTurquesa"
                    style="-fx-background-color: #1abc9c; -fx-text-fill: white;" />
        </HBox>

        <Button text="Cambiar Texto del Label" onAction="#cambiarTextoLabel"
                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-pref-width: 180px;" />

        <Button text="Habilitar / Deshabilitar Botón" onAction="#toggleBoton"
                style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-pref-width: 180px;" />

        <Button fx:id="secondaryButton" onAction="#switchToPrimary" text="Volver A Cambiar"
                style="-fx-background-color: #19d1ce; -fx-text-fill: white; -fx-pref-width: 180px;" />

    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
